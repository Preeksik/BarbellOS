# Skopiuj do pliku .env (ten sam katalog). Plik .env nie trafia do repo.

# dev: logowanie jest pomijane, dopóki APP_PASSWORD_HASH jest puste.
# prod: aplikacja nie wystartuje bez SECRET_KEY, APP_PASSWORD_HASH i INGEST_TOKEN.
ENVIRONMENT=dev

# Lokalnie z Dockerem (docker compose up -d db):
DATABASE_URL=postgresql://barbellos:barbellos@localhost:5432/barbellos
# Bez Dockera, na szybki start:
# DATABASE_URL=sqlite:///./barbellos.db

# Losowe wartości:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
INGEST_TOKEN=

# Hash hasła:  python -m app.tools.hash_password   (w katalogu backend)
# Wartość zawiera znaki $, dlatego musi być w pojedynczych cudzysłowach.
APP_PASSWORD_HASH=

# Open Food Facts prosi o nagłówek identyfikujący aplikację: wpisz adres repo.
OFF_USER_AGENT=BarbellOS/0.1 (https://github.com/TWOJ-LOGIN/BarbellOS)
# Adresy Open Food Facts. Zmieniasz tylko wtedy, gdy OFF przeniesie API.
# OFF_BASE_URL=https://world.openfoodfacts.org
# OFF_SEARCH_URL=https://search.openfoodfacts.org
# Kraj sprzedaży w wyszukiwarce produktów (domyślnie rynek polski); puste = wszystkie kraje.
# OFF_SEARCH_COUNTRY=en:poland

# USDA FoodData Central: witaminy i minerały z tabel (dopasowanie produktu do tabeli).
# Darmowy klucz: https://fdc.nal.usda.gov/api-key-signup (limit 1000 zapytań na godzinę).
# Bez klucza działa DEMO_KEY: tylko ok. 10 zapytań na godzinę.
FDC_API_KEY=
# Produkt dodany do dziennika sam dopasowuje się do tabeli USDA (witaminy). false = wyłączone.
# MICROS_AUTOFILL=true

# AI. Zdjęcie etykiety (etap 1, krok 3) wymaga klucza Gemini: darmowy klucz tworzysz na
# https://aistudio.google.com/apikey . Bez klucza reszta aplikacji działa normalnie.
# Klucz Claude nie jest jeszcze używany (etap 2).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Nazwy modeli zmieniają się: sprawdź aktualne w AI Studio i w dokumentacji Anthropic.
# GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
# GEMINI_MODEL_MID=gemini-3.8-flash
# CLAUDE_MODEL_CHEAP=claude-haiku-5-5
# CLAUDE_MODEL_MID=claude-sonnet-5-5
# CLAUDE_MODEL_STRONG=claude-opus-5-5
